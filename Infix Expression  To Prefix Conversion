def precedence(opt):
    if opt=='^':
        return 3
    elif opt=='*' or opt=='/':
        return 2
    elif opt=='+' or opt=='-':
        return 1
    else:
        return 0

def infix_to_postfix(expression):
    postfix = ""
    stack = []
    for ch in expression:
        if ch.isalnum():
            postfix += ch
        elif ch == '(':
            stack.append(ch)
        elif ch == ')':
            while stack and stack[-1] != '(':
                postfix += stack.pop()
            stack.pop()
        else:
            while stack and precedence(stack[-1]) >= precedence(ch):
                postfix += stack.pop()
            stack.append(ch)
    while stack:
        postfix += stack.pop()
    return postfix
            

exp = input("Enter Expression :  ")
print("Infix to Postfix :  ",infix_to_postfix(exp))
